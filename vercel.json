{
    "rewrites": [
        {
            "source": "/og-test/:slug",
            "destination": "/api/og-test"
        },
        {
            "source": "/evento/:slug",
            "destination": "/api/og-evento"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/((?!api|uploads|assets|favicon\\.ico|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}